{
 "align_labels_right": 0,
 "creation": "2026-10-07 20:45:00.000000",
 "custom_format": 0,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Repair Order",
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<div class=\"bay-worksheet\" style=\"font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; color: #2d3748; line-height: 1.4;\">\n\t<!-- Header -->\n\t<div style=\"display: flex; justify-content: space-between; border-bottom: 3px solid #e2e8f0; padding-bottom: 10px; margin-bottom: 15px;\">\n\t\t<div>\n\t\t\t<h2 style=\"margin: 0; font-size: 22px; text-transform: uppercase; letter-spacing: 0.5px;\">TECHNICIAN BAY WORKSHEET</h2>\n\t\t\t<div style=\"color: #718096; font-size: 13px;\">{{ doc.company }} &bull; Workshop Job Card</div>\n\t\t</div>\n\t\t<div style=\"text-align: right;\">\n\t\t\t<h3 style=\"margin: 0; font-size: 22px; color: #2b6cb0;\">RO # {{ doc.name }}</h3>\n\t\t\t<div style=\"font-size: 12px; color: #718096;\">Date: {{ frappe.format_date(doc.posting_date) }}</div>\n\t\t</div>\n\t</div>\n\n\t<!-- Vehicle Info Bar -->\n\t<div style=\"background: #edf2f7; border: 1px solid #cbd5e0; border-radius: 6px; padding: 12px; margin-bottom: 18px;\">\n\t\t<div style=\"display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #cbd5e0; padding-bottom: 8px; margin-bottom: 8px;\">\n\t\t\t<div>\n\t\t\t\t<span style=\"font-size: 16px; font-weight: bold;\">\n\t\t\t\t\t{{ frappe.db.get_value(\"Repair Vehicle\", doc.vehicle, \"model_year\") or \"\" }}\n\t\t\t\t\t{{ frappe.db.get_value(\"Repair Vehicle\", doc.vehicle, \"manufacturer\") or \"\" }}\n\t\t\t\t\t{{ frappe.db.get_value(\"Repair Vehicle\", doc.vehicle, \"model\") or \"\" }}\n\t\t\t\t</span>\n\t\t\t\t&nbsp;&bull;&nbsp;\n\t\t\t\t<span><b>Plate:</b> {{ frappe.db.get_value(\"Repair Vehicle\", doc.vehicle, \"license_plate\") or \"N/A\" }}</span>\n\t\t\t</div>\n\t\t\t<div>\n\t\t\t\t<b>Odometer In:</b> {{ doc.odometer_in }} km\n\t\t\t</div>\n\t\t</div>\n\t\t<div style=\"font-size: 12px; color: #4a5568;\">\n\t\t\t<b>VIN:</b> {{ frappe.db.get_value(\"Repair Vehicle\", doc.vehicle, \"vin\") or \"N/A\" }} &nbsp;&bull;&nbsp;\n\t\t\t<b>Advisor:</b> {{ doc.service_advisor or \"Unassigned\" }} &nbsp;&bull;&nbsp;\n\t\t\t<b>Customer:</b> {{ doc.customer }}\n\t\t</div>\n\t</div>\n\n\t{% if doc.customer_concern %}\n\t<div style=\"margin-bottom: 18px; padding: 10px; background: #fffaf0; border-left: 4px solid #ed8936; border-radius: 4px;\">\n\t\t<div style=\"font-size: 11px; text-transform: uppercase; font-weight: bold; color: #c05621;\">Primary Customer Concern / Reported Symptoms</div>\n\t\t<div style=\"font-size: 13px; color: #2d3748; margin-top: 3px;\">{{ doc.customer_concern }}</div>\n\t</div>\n\t{% endif %}\n\n\t<!-- Operations Checklist -->\n\t<div style=\"margin-bottom: 25px;\">\n\t\t<h4 style=\"border-bottom: 2px solid #2d3748; padding-bottom: 4px; font-size: 14px; text-transform: uppercase; margin-bottom: 12px;\">Workshop Service Operations</h4>\n\t\t{% for s in (doc.services or []) %}\n\t\t{% if s.status != 'Declined' %}\n\t\t<div style=\"margin-bottom: 16px; border: 1px solid #cbd5e0; border-radius: 6px; overflow: hidden;\">\n\t\t\t<div style=\"background: #f7fafc; padding: 8px 12px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #edf2f7;\">\n\t\t\t\t<div>\n\t\t\t\t\t<input type=\"checkbox\" {% if s.is_completed %}checked{% endif %} style=\"transform: scale(1.3); margin-right: 8px;\">\n\t\t\t\t\t<b style=\"font-size: 14px;\">{{ s.service_title or s.service_package }}</b>\n\t\t\t\t\t{% if s.correction_code %}<span style=\"font-size: 11px; background: #e2e8f0; color: #4a5568; padding: 2px 6px; border-radius: 8px; margin-left: 6px;\">{{ s.correction_code }}</span>{% endif %}\n\t\t\t\t\t{% if s.service_position and s.service_position != 'None' %}<span style=\"font-size: 11px; background: #bee3f8; color: #2b6cb0; padding: 2px 6px; border-radius: 8px; margin-left: 4px;\">{{ s.service_position }}</span>{% endif %}\n\t\t\t\t\t{% if s.is_supplement %}<span style=\"font-size: 10px; background: #feebc8; color: #c05621; padding: 2px 6px; border-radius: 8px; margin-left: 4px; font-weight: bold;\">SUPPLEMENT</span>{% endif %}\n\t\t\t\t\t<span style=\"font-size: 10px; background: {{ '#c6f6d5' if s.status == 'Approved' else '#fefcbf' }}; color: {{ '#22543d' if s.status == 'Approved' else '#744210' }}; padding: 2px 6px; border-radius: 8px; margin-left: 4px;\">{{ s.status }}</span>\n\t\t\t\t</div>\n\t\t\t\t<div style=\"font-size: 12px; color: #718096;\">\n\t\t\t\t\tTech: <b>{{ s.assigned_technician or \"Unassigned\" }}</b> &bull; Book: <b>{{ s.labor_hours or 0 }} hrs</b>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div style=\"padding: 10px;\">\n\t\t\t\t{% if s.advisor_notes %}\n\t\t\t\t<div style=\"font-size: 12px; color: #4a5568; margin-bottom: 8px;\"><b>Instructions:</b> {{ s.advisor_notes }}</div>\n\t\t\t\t{% endif %}\n\n\t\t\t\t{% set s_parts = json.loads(s.parts) if (s.parts and s.parts is string) else (s.parts or []) %}\n\t\t\t\t{% if s_parts %}\n\t\t\t\t<div style=\"font-size: 11px; font-weight: bold; text-transform: uppercase; color: #718096; margin-bottom: 4px;\">Required Parts & Materials</div>\n\t\t\t\t<table style=\"width: 100%; font-size: 12px; border-collapse: collapse;\">\n\t\t\t\t\t<thead>\n\t\t\t\t\t\t<tr style=\"background: #edf2f7; text-align: left;\">\n\t\t\t\t\t\t\t<th style=\"padding: 4px 6px; width: 25%;\">Part Code</th>\n\t\t\t\t\t\t\t<th style=\"padding: 4px 6px; width: 45%;\">Description & Source</th>\n\t\t\t\t\t\t\t<th style=\"padding: 4px 6px; width: 15%;\">Qty Required</th>\n\t\t\t\t\t\t\t<th style=\"padding: 4px 6px; width: 15%; text-align: center;\">Picked / Installed</th>\n\t\t\t\t\t\t</tr>\n\t\t\t\t\t</thead>\n\t\t\t\t\t<tbody>\n\t\t\t\t\t\t{% for p in s_parts %}\n\t\t\t\t\t\t<tr style=\"border-bottom: 1px solid #edf2f7;\">\n\t\t\t\t\t\t\t<td style=\"padding: 4px 6px; font-family: monospace;\">{{ p.item_code }}{% if p.oem_part_number %}<div style=\"font-size: 10px; color: #718096;\">OEM: {{ p.oem_part_number }}</div>{% endif %}</td>\n\t\t\t\t\t\t\t<td style=\"padding: 4px 6px;\">{{ p.item_name }} <span style=\"font-size: 10px; color: #4a5568;\">[{{ p.part_source or 'OEM' }} - {{ p.part_condition or 'New' }}]</span></td>\n\t\t\t\t\t\t\t<td style=\"padding: 4px 6px;\"><b>{{ p.qty }}</b> {{ p.uom or '' }}</td>\n\t\t\t\t\t\t\t<td style=\"padding: 4px 6px; text-align: center;\">[ &nbsp; ]</td>\n\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t{% endfor %}\n\t\t\t\t\t</tbody>\n\t\t\t\t</table>\n\t\t\t\t{% else %}\n\t\t\t\t<div style=\"font-size: 11px; color: #a0aec0; font-style: italic;\">Labor-only operation (no parts allocated).</div>\n\t\t\t\t{% endif %}\n\t\t\t</div>\n\t\t</div>\n\t\t{% endif %}\n\t\t{% endfor %}\n\t</div>\n\n\t<!-- Technician Diagnostic / Teardown Notes -->\n\t<div style=\"border: 1px solid #cbd5e0; border-radius: 6px; padding: 12px; margin-bottom: 25px;\">\n\t\t<div style=\"font-size: 12px; font-weight: bold; text-transform: uppercase; color: #4a5568; margin-bottom: 6px;\">\n\t\t\tTechnician Teardown Findings / Discovered Defects\n\t\t</div>\n\t\t<div style=\"min-height: 80px; border-bottom: 1px dotted #cbd5e0;\"></div>\n\t\t<div style=\"min-height: 40px;\"></div>\n\t</div>\n\n\t<!-- Sign-off & Quality Inspection -->\n\t<div style=\"display: flex; justify-content: space-between; font-size: 12px;\">\n\t\t<div style=\"width: 30%; border-top: 1px solid #718096; padding-top: 6px;\">\n\t\t\t<b>Lead Technician Sign-off</b>\n\t\t\t<div style=\"color: #718096; font-size: 11px;\">Signature & Date</div>\n\t\t</div>\n\t\t<div style=\"width: 30%; border-top: 1px solid #718096; padding-top: 6px;\">\n\t\t\t<b>Final Odometer Out:</b> _____________\n\t\t\t<div style=\"color: #718096; font-size: 11px;\">Verified by Tester</div>\n\t\t</div>\n\t\t<div style=\"width: 30%; border-top: 1px solid #718096; padding-top: 6px;\">\n\t\t\t<b>Quality Control Sign-off</b>\n\t\t\t<div style=\"color: #718096; font-size: 11px;\">Road Test & Inspection</div>\n\t\t</div>\n\t</div>\n</div>",
 "line_breaks": 0,
 "margin_bottom": 15.0,
 "margin_left": 15.0,
 "margin_right": 15.0,
