{
 "align_labels_right": 0,
 "creation": "2026-10-07 20:45:00.000000",
 "custom_format": 0,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Repair Order",
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<div class=\"repair-order-print\" style=\"font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; color: #333; line-height: 1.4;\">\n\t<!-- Header -->\n\t<div style=\"display: flex; justify-content: space-between; border-bottom: 2px solid #2b6cb0; padding-bottom: 12px; margin-bottom: 15px;\">\n\t\t<div>\n\t\t\t<h2 style=\"margin: 0; color: #2b6cb0; font-size: 24px;\">{{ doc.company }}</h2>\n\t\t\t<div style=\"color: #666; font-size: 13px;\">Automotive Service & Repair</div>\n\t\t</div>\n\t\t<div style=\"text-align: right;\">\n\t\t\t<h3 style=\"margin: 0; font-size: 20px;\">REPAIR ORDER</h3>\n\t\t\t<div style=\"font-size: 14px; font-weight: bold; color: #2b6cb0;\"># {{ doc.name }}</div>\n\t\t\t<div style=\"font-size: 12px; color: #777;\">Date: {{ frappe.format_date(doc.posting_date) }}</div>\n\t\t\t<div style=\"font-size: 12px; color: #777;\">Status: <b>{{ doc.status }}</b></div>\n\t\t</div>\n\t</div>\n\n\t<!-- Vehicle & Customer Banner -->\n\t<div style=\"display: flex; background: #f7fafc; border: 1px solid #e2e8f0; border-radius: 6px; padding: 12px; margin-bottom: 20px;\">\n\t\t<div style=\"flex: 1; border-right: 1px solid #e2e8f0; padding-right: 15px;\">\n\t\t\t<div style=\"font-size: 11px; text-transform: uppercase; color: #718096; font-weight: bold;\">CUSTOMER DETAILS</div>\n\t\t\t<div style=\"font-size: 14px; font-weight: bold; margin-top: 4px;\">{{ doc.customer }}</div>\n\t\t\t{% if doc.contact_person %}\n\t\t\t<div style=\"font-size: 12px; color: #4a5568;\">Contact: {{ doc.contact_person }}</div>\n\t\t\t{% endif %}\n\t\t\t{% if doc.service_advisor %}\n\t\t\t<div style=\"font-size: 12px; color: #4a5568;\">Advisor: {{ doc.service_advisor }}</div>\n\t\t\t{% endif %}\n\t\t</div>\n\t\t<div style=\"flex: 1.5; padding-left: 15px;\">\n\t\t\t<div style=\"font-size: 11px; text-transform: uppercase; color: #718096; font-weight: bold;\">VEHICLE SPECIFICATION</div>\n\t\t\t<div style=\"font-size: 14px; font-weight: bold; margin-top: 4px; color: #2d3748;\">\n\t\t\t\t{{ frappe.db.get_value(\"Repair Vehicle\", doc.vehicle, \"model_year\") or \"\" }}\n\t\t\t\t{{ frappe.db.get_value(\"Repair Vehicle\", doc.vehicle, \"manufacturer\") or \"\" }}\n\t\t\t\t{{ frappe.db.get_value(\"Repair Vehicle\", doc.vehicle, \"model\") or \"\" }}\n\t\t\t</div>\n\t\t\t<div style=\"font-size: 12px; color: #4a5568; margin-top: 2px;\">\n\t\t\t\t<b>VIN:</b> {{ frappe.db.get_value(\"Repair Vehicle\", doc.vehicle, \"vin\") or \"N/A\" }} &nbsp;|&nbsp;\n\t\t\t\t<b>Plate:</b> {{ frappe.db.get_value(\"Repair Vehicle\", doc.vehicle, \"license_plate\") or \"N/A\" }}\n\t\t\t</div>\n\t\t\t<div style=\"font-size: 12px; color: #4a5568; margin-top: 2px;\">\n\t\t\t\t<b>Odometer In:</b> {{ doc.odometer_in }} km &nbsp;|&nbsp;\n\t\t\t\t<b>Odometer Out:</b> {{ doc.odometer_out or \"\u2014\" }} km\n\t\t\t</div>\n\t\t</div>\n\t</div>\n\n\t{% if doc.customer_concern %}\n\t<div style=\"margin-bottom: 20px; padding: 10px; background: #fffaf0; border-left: 4px solid #dd6b20; border-radius: 4px;\">\n\t\t<b style=\"color: #c05621; font-size: 12px;\">Customer Concern / Symptoms:</b>\n\t\t<div style=\"font-size: 13px; color: #2d3748; margin-top: 2px;\">{{ doc.customer_concern }}</div>\n\t</div>\n\t{% endif %}\n\n\t<!-- Grouped Operations & Services -->\n\t<div style=\"margin-bottom: 25px;\">\n\t\t<h4 style=\"border-bottom: 1px solid #cbd5e0; padding-bottom: 6px; font-size: 14px; text-transform: uppercase; color: #4a5568;\">Itemized Operations & Services</h4>\n\t\t{% set active_services = doc.services if doc.services else [] %}\n\t\t{% for s in active_services %}\n\t\t{% if s.status != 'Declined' %}\n\t\t<div style=\"margin-bottom: 15px; border: 1px solid #e2e8f0; border-radius: 6px; overflow: hidden;\">\n\t\t\t<div style=\"background: #edf2f7; padding: 8px 12px; display: flex; justify-content: space-between; align-items: center;\">\n\t\t\t\t<div>\n\t\t\t\t\t<b style=\"font-size: 14px; color: #2d3748;\">{{ s.service_title or s.service_package }}</b>\n\t\t\t\t\t{% if s.correction_code %}<span style=\"font-size: 11px; background: #e2e8f0; color: #4a5568; padding: 2px 6px; border-radius: 4px; margin-left: 6px;\">{{ s.correction_code }}</span>{% endif %}\n\t\t\t\t\t{% if s.service_position and s.service_position != 'None' %}<span style=\"font-size: 11px; background: #bee3f8; color: #2b6cb0; padding: 2px 6px; border-radius: 4px; margin-left: 4px;\">{{ s.service_position }}</span>{% endif %}\n\t\t\t\t</div>\n\t\t\t\t<div style=\"font-size: 13px; font-weight: bold; color: #2b6cb0;\">\n\t\t\t\t\t${{ \"{:,.2f}\".format(s.total_amount) }}\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div style=\"padding: 10px;\">\n\t\t\t\t<table style=\"width: 100%; font-size: 12px; border-collapse: collapse;\">\n\t\t\t\t\t<thead>\n\t\t\t\t\t\t<tr style=\"color: #718096; border-bottom: 1px solid #e2e8f0; text-align: left;\">\n\t\t\t\t\t\t\t<th style=\"padding: 4px 6px; width: 12%;\">Type</th>\n\t\t\t\t\t\t\t<th style=\"padding: 4px 6px; width: 48%;\">Description & Compliance Disclosure</th>\n\t\t\t\t\t\t\t<th style=\"padding: 4px 6px; width: 10%; text-align: center;\">Qty</th>\n\t\t\t\t\t\t\t<th style=\"padding: 4px 6px; width: 15%; text-align: right;\">Unit Price</th>\n\t\t\t\t\t\t\t<th style=\"padding: 4px 6px; width: 15%; text-align: right;\">Total</th>\n\t\t\t\t\t\t</tr>\n\t\t\t\t\t</thead>\n\t\t\t\t\t<tbody>\n\t\t\t\t\t\t{% if s.labor_hours or s.labor_amount %}\n\t\t\t\t\t\t<tr style=\"border-bottom: 1px solid #f7fafc;\">\n\t\t\t\t\t\t\t<td style=\"padding: 4px 6px;\"><span style=\"color: #4a5568; font-weight: 500;\">Labor</span></td>\n\t\t\t\t\t\t\t<td style=\"padding: 4px 6px;\"><b>Labor: {{ s.service_title }}</b> <span style=\"color: #718096;\">({{ s.labor_hours }} hrs @ ${{ \"{:,.2f}\".format(s.labor_rate) }}/hr)</span></td>\n\t\t\t\t\t\t\t<td style=\"padding: 4px 6px; text-align: center;\">{{ s.labor_hours }}</td>\n\t\t\t\t\t\t\t<td style=\"padding: 4px 6px; text-align: right;\">${{ \"{:,.2f}\".format(s.labor_rate) }}</td>\n\t\t\t\t\t\t\t<td style=\"padding: 4px 6px; text-align: right;\">${{ \"{:,.2f}\".format(s.labor_amount) }}</td>\n\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t{% endif %}\n\t\t\t\t\t\t{% set s_parts = json.loads(s.parts) if (s.parts and s.parts is string) else (s.parts or []) %}\n\t\t\t\t\t\t{% for p in s_parts %}\n\t\t\t\t\t\t<tr style=\"border-bottom: 1px solid #f7fafc;\">\n\t\t\t\t\t\t\t<td style=\"padding: 4px 6px;\"><span style=\"color: #2b6cb0; font-weight: 500;\">Part</span></td>\n\t\t\t\t\t\t\t<td style=\"padding: 4px 6px;\">\n\t\t\t\t\t\t\t\t<b>{{ p.item_code }}</b> - {{ p.item_name }}\n\t\t\t\t\t\t\t\t<div style=\"margin-top: 2px;\">\n\t\t\t\t\t\t\t\t\t<span style=\"display: inline-block; padding: 1px 5px; font-size: 10px; font-weight: bold; background: #e2e8f0; color: #2d3748; border-radius: 3px;\">{{ p.part_source or 'OEM' }}</span>\n\t\t\t\t\t\t\t\t\t<span style=\"display: inline-block; padding: 1px 5px; font-size: 10px; font-weight: bold; background: #c6f6d5; color: #22543d; border-radius: 3px; margin-left: 3px;\">{{ p.part_condition or 'New' }}</span>\n\t\t\t\t\t\t\t\t\t{% if p.warranty_period %}\n\t\t\t\t\t\t\t\t\t<span style=\"color: #718096; font-size: 11px; margin-left: 6px;\">Warranty: {{ p.warranty_period }}</span>\n\t\t\t\t\t\t\t\t\t{% endif %}\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t<td style=\"padding: 4px 6px; text-align: center;\">{{ p.qty }}</td>\n\t\t\t\t\t\t\t<td style=\"padding: 4px 6px; text-align: right;\">${{ \"{:,.2f}\".format(p.rate) }}</td>\n\t\t\t\t\t\t\t<td style=\"padding: 4px 6px; text-align: right;\">${{ \"{:,.2f}\".format(p.amount or (p.qty * p.rate)) }}</td>\n\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t{% endfor %}\n\t\t\t\t\t</tbody>\n\t\t\t\t</table>\n\t\t\t</div>\n\t\t</div>\n\t\t{% endif %}\n\t\t{% endfor %}\n\t</div>\n\n\t<!-- Totals -->\n\t<div style=\"display: flex; justify-content: flex-end; margin-bottom: 30px;\">\n\t\t<table style=\"width: 280px; font-size: 13px; border-collapse: collapse;\">\n\t\t\t<tr>\n\t\t\t\t<td style=\"padding: 5px 8px; color: #718096;\">Subtotal (Net):</td>\n\t\t\t\t<td style=\"padding: 5px 8px; text-align: right; font-weight: 500;\">${{ \"{:,.2f}\".format(doc.net_total) }}</td>\n\t\t\t</tr>\n\t\t\t<tr>\n\t\t\t\t<td style=\"padding: 5px 8px; color: #718096;\">Ontario HST ({{ doc.tax_rate }}%):</td>\n\t\t\t\t<td style=\"padding: 5px 8px; text-align: right; font-weight: 500;\">${{ \"{:,.2f}\".format(doc.total_taxes_and_charges) }}</td>\n\t\t\t</tr>\n\t\t\t<tr style=\"border-top: 2px solid #2b6cb0; font-size: 15px; font-weight: bold;\">\n\t\t\t\t<td style=\"padding: 8px; color: #2b6cb0;\">Grand Total:</td>\n\t\t\t\t<td style=\"padding: 8px; text-align: right; color: #2b6cb0;\">${{ \"{:,.2f}\".format(doc.grand_total) }}</td>\n\t\t\t</tr>\n\t\t\t{% if doc.paid_amount %}\n\t\t\t<tr style=\"color: #38a169;\">\n\t\t\t\t<td style=\"padding: 5px 8px;\">Paid to Date:</td>\n\t\t\t\t<td style=\"padding: 5px 8px; text-align: right;\">${{ \"{:,.2f}\".format(doc.paid_amount) }}</td>\n\t\t\t</tr>\n\t\t\t<tr style=\"font-weight: bold; color: #e53e3e;\">\n\t\t\t\t<td style=\"padding: 5px 8px;\">Balance Due:</td>\n\t\t\t\t<td style=\"padding: 5px 8px; text-align: right;\">${{ \"{:,.2f}\".format(doc.outstanding_amount) }}</td>\n\t\t\t</tr>\n\t\t\t{% endif %}\n\t\t</table>\n\t</div>\n\n\t<!-- Warranty & Signature -->\n\t<div style=\"border-top: 1px solid #e2e8f0; padding-top: 15px; font-size: 11px; color: #718096;\">\n\t\t<p style=\"margin-bottom: 25px;\">\n\t\t\t<b>Warranty Terms:</b> All parts and labor are backed by our 12-Month / 20,000 km Limited Warranty. We hereby certify that the repairs specified herein have been performed according to manufacturer standards.\n\t\t</p>\n\t\t<div style=\"display: flex; justify-content: space-between;\">\n\t\t\t<div style=\"width: 45%; border-top: 1px solid #a0aec0; padding-top: 6px;\">\n\t\t\t\tCustomer Authorization Signature\n\t\t\t\t{% if doc.authorized_by %}\n\t\t\t\t<div style=\"color: #2d3748; font-weight: bold; margin-top: 4px;\">{{ doc.authorized_by }}</div>\n\t\t\t\t{% endif %}\n\t\t\t</div>\n\t\t\t<div style=\"width: 45%; border-top: 1px solid #a0aec0; padding-top: 6px;\">\n\t\t\t\tService Center Sign-Off\n\t\t\t\t<div style=\"color: #2d3748; font-weight: bold; margin-top: 4px;\">{{ doc.service_advisor or doc.company }}</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</div>",
 "line_breaks": 0,
